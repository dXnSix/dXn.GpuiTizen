# Tizen symbols dxn_gpui_tizen_sys may declare and a TV library may import, each with the public
# Tizen 8.0 native API module (and header) that documents it. One `<symbol> <module>` per line.
# A new symbol enters only together with its declaration (`symbols::tests` keeps both in step);
# Ecore, Ecore_Wl2 and Ecore_IMF are documented under "EFL (Deprecated)".

# libcapi-appfw-application.so
ui_app_main Application Framework > Application (appfw/app.h)
ui_app_exit Application Framework > Application (appfw/app.h)

# libcapi-appfw-app-common.so
app_get_cache_path Application Framework > Application > Common (appfw/app_common.h)
app_get_resource_path Application Framework > Application > Common (appfw/app_common.h)
app_get_data_path Application Framework > Application > Common (appfw/app_common.h)

# libcapi-appfw-app-control.so
app_control_get_extra_data Application Framework > Application > App Control (appfw/app_control.h)
app_control_foreach_extra_data Application Framework > Application > App Control (appfw/app_control.h)

